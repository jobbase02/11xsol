# Copy this file to .env.local and fill in values for local development.
# NEVER commit your real API keys (.env.local is in .gitignore).
# In production, set these variables in Vercel / Netlify dashboard.

# --- Resend (Emails) ---
# 1. Sign up at https://resend.com (Free - 3,000 emails/month)
# 2. Create an API Key in your dashboard and paste below:
RESEND_API_KEY=re_your_resend_api_key_here

# Where you want the booking inquiries forwarded to:
# Note: In Resend free sandbox testing, this must be your Resend account email (e.g. jobbase02@gmail.com).
CONTACT_EMAIL=jobbase02@gmail.com

# Sender email:
# During initial testing without a custom domain, leave as:
RESEND_FROM_EMAIL=Eleven X Solutions <onboarding@resend.dev>
# Once you verify your domain (e.g. elevenxsolutions.com) in Resend:
# RESEND_FROM_EMAIL=Eleven X Solutions <contact@elevenxsolutions.com>


# --- Supabase Database & Storage (Optional) ---
# If configured, bookings are archived and image assets can be hosted via Supabase Storage:
NEXT_PUBLIC_SUPABASE_URL=https://vbvdppslacwfjqutgckp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZidmRwcHNsYWN3ZmpxdXRnY2twIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAzOTkzMjAsImV4cCI6MjEwNTk3NTMyMH0.sXmetU073pfLFDDfwIKwUIYRvcM3fgAKIKEa0dms1yM
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=site-assets

# --- Groq AI (Chatbot) ---
# Get your free key at https://console.groq.com/keys
GROK_API_KEY=gsk_your_groq_api_key_here

# --- Upstash Redis (Rate Limiting & Caching - Optional) ---
# 1. Sign up at https://console.upstash.com (Free - 10,000 requests/day)
# 2. Create a Redis database, scroll down to "REST API", and copy:
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Cloudinary (Video CDN & Auto-Optimization - Optional) ---
# 1. Sign up at https://cloudinary.com (Free - 25 GB bandwidth/month)
# 2. Upload public/Video.mp4 to your Media Library
# 3. Paste your Cloud Name below (e.g. dndee-11x):
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=pllapiw7
# (Or paste a direct custom video URL if using another CDN):
# NEXT_PUBLIC_HERO_VIDEO_URL=https://...
# NEXT_PUBLIC_HERO_VIDEO_POSTER=https://...

